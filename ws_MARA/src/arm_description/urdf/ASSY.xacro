<?xml version="1.0" ?>
<robot name="ASSY" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include Materials, ROS2 Control Transmissions, and Gazebo Plugins -->
  <xacro:include filename="$(find arm_description)/urdf/materials.xacro" />
  <xacro:include filename="$(find arm_description)/urdf/ASSY.trans" />
  <xacro:include filename="$(find arm_description)/urdf/ASSY.gazebo" />

  <!-- Base Link -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.0 0.0 0.045" rpy="0 0 0"/>
      <mass value="1.500"/>
      <inertia ixx="0.0035" ixy="0.0" ixz="0.0" iyy="0.0035" iyz="0.0" izz="0.0050"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find arm_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find arm_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 1 (Base Rotation - Yaw around Z) -->
  <joint name="joint_1" type="revolute">
    <origin xyz="0.0 0.0 0.09" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="2nd_link_1"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit lower="-3.14159" upper="3.14159" effort="100.0" velocity="3.14"/>
    <dynamics damping="0.7" friction="0.5"/>
  </joint>

  <!-- Link 2 (Shoulder Turret) -->
  <link name="2nd_link_1">
    <inertial>
      <origin xyz="0.0 0.0 0.04" rpy="0 0 0"/>
      <mass value="1.200"/>
      <inertia ixx="0.0025" ixy="0.0" ixz="0.0" iyy="0.0025" iyz="0.0" izz="0.0020"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find arm_description)/meshes/2nd_link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find arm_description)/meshes/2nd_link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 2 (Shoulder Pitch around Y) -->
  <joint name="joint_2" type="revolute">
    <origin xyz="0.0 0.0 0.08" rpy="0 0 0"/>
    <parent link="2nd_link_1"/>
    <child link="3rd_link_1"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit lower="-1.5708" upper="1.5708" effort="150.0" velocity="2.50"/>
    <dynamics damping="0.7" friction="0.5"/>
  </joint>

  <!-- Link 3 (Upper Arm - Shoulder to Elbow, a1 = 25 cm) -->
  <link name="3rd_link_1">
    <inertial>
      <origin xyz="0.0 0.0 0.125" rpy="0 0 0"/>
      <mass value="0.950"/>
      <inertia ixx="0.0050" ixy="0.0" ixz="0.0" iyy="0.0050" iyz="0.0" izz="0.0010"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find arm_description)/meshes/3rd_link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find arm_description)/meshes/3rd_link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 3 (Elbow Pitch around Y) -->
  <joint name="joint_3" type="revolute">
    <origin xyz="0.0 0.0 0.25" rpy="0 0 0"/>
    <parent link="3rd_link_1"/>
    <child link="4th_link_1"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit lower="-1.5708" upper="1.5708" effort="100.0" velocity="2.50"/>
    <dynamics damping="0.7" friction="0.5"/>
  </joint>

  <!-- Link 4 (Forearm - Elbow to Wrist, a2 = 19 cm) -->
  <link name="4th_link_1">
    <inertial>
      <origin xyz="0.0 0.0 0.095" rpy="0 0 0"/>
      <mass value="0.650"/>
      <inertia ixx="0.0020" ixy="0.0" ixz="0.0" iyy="0.0020" iyz="0.0" izz="0.0006"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find arm_description)/meshes/4th_link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find arm_description)/meshes/4th_link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 4 (Wrist Pitch around Y) -->
  <joint name="joint_4" type="revolute">
    <origin xyz="0.0 0.0 0.19" rpy="0 0 0"/>
    <parent link="4th_link_1"/>
    <child link="5th_link_1"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit lower="-1.5708" upper="1.5708" effort="50.0" velocity="3.14"/>
    <dynamics damping="0.5" friction="0.3"/>
  </joint>

  <!-- Link 5 (Wrist / Tool Flange, a3 = 6 cm) -->
  <link name="5th_link_1">
    <inertial>
      <origin xyz="0.0 0.0 0.03" rpy="0 0 0"/>
      <mass value="0.300"/>
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find arm_description)/meshes/5th_link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find arm_description)/meshes/5th_link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint 5 (Wrist Roll / Gripper Mount around Z) -->
  <joint name="joint_5" type="revolute">
    <origin xyz="0.0 0.0 0.06" rpy="0 0 0"/>
    <parent link="5th_link_1"/>
    <child link="end_effector_link"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit lower="-3.14159" upper="3.14159" effort="30.0" velocity="3.14"/>
    <dynamics damping="0.5" friction="0.3"/>
  </joint>

  <!-- End Effector Link (Tool Center Point) -->
  <link name="end_effector_link">
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <mass value="0.100"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.02"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.02"/>
      </geometry>
    </collision>
  </link>

</robot>
