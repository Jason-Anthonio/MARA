<?xml version="1.0" ?>
<robot name="ASSY_materials" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="silver">
    <color rgba="0.700 0.700 0.700 1.000"/>
  </material>

  <material name="black">
    <color rgba="0.100 0.100 0.100 1.000"/>
  </material>

  <material name="blue">
    <color rgba="0.200 0.400 0.800 1.000"/>
  </material>

  <material name="orange">
    <color rgba="1.000 0.400 0.000 1.000"/>
  </material>

  <material name="white">
    <color rgba="1.000 1.000 1.000 1.000"/>
  </material>

  <material name="dark_grey">
    <color rgba="0.300 0.300 0.300 1.000"/>
  </material>

</robot>
