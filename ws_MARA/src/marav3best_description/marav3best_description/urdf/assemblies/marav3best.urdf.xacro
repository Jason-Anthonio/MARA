      <collision>
        <origin xyz="-0.050000 0.000000 -0.065500" rpy="-1.570796 0.000000 1.570796"/>
        <geometry>
          <mesh filename="package://marav3best_description/meshes/marav3best/RG_shoulder_link.dae" scale="1 1 1"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}RG_shoulder_arm">
      <inertial>
        <origin xyz="-0.000448 -0.033726 -0.081688" rpy="0 0 0"/>
        <mass value="0.739230"/>
        <inertia ixx="2.803067e-03" ixy="-1.696123e-05" ixz="2.201297e-06"
                 iyy="1.516943e-03" iyz="1.625498e-04" izz="2.087611e-03"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 -0.029000" rpy="0.000000 0.000000 3.128233"/>
        <geometry>
          <mesh filename="package://marav3best_description/meshes/marav3best/RG_shoulder_arm.dae" scale="1 1 1"/>
