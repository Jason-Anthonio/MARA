<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="marav3best_macro">

  <xacro:macro name="marav3best" params="prefix">

    <!-- Links -->
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="-0.002348 -0.000935 0.048147" rpy="0 0 0"/>
        <mass value="1.835799"/>
        <inertia ixx="9.135036e-03" ixy="-3.556599e-05" ixz="3.306054e-05"
                 iyy="1.030374e-02" iyz="6.878454e-06" izz="1.158690e-02"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="1.570796 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://marav3best_description/meshes/marav3best/base_link.dae" scale="1 1 1"/>
        </geometry>
        <material name="Generic"/>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="1.570796 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://marav3best_description/meshes/marav3best/base_link.dae" scale="1 1 1"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}RG_shoulder_link">
