        <origin xyz="0.001929 0.006923 -0.042870" rpy="0 0 0"/>
        <mass value="0.515218"/>
        <inertia ixx="9.696249e-04" ixy="-2.750271e-04" ixz="7.615150e-05"
                 iyy="2.598872e-03" iyz="7.590550e-05" izz="2.593069e-03"/>
      </inertial>
      <visual>
        <origin xyz="-0.050000 0.000000 -0.065500" rpy="-1.570796 0.000000 1.570796"/>
        <geometry>
          <mesh filename="package://marav3best_description/meshes/marav3best/RG_shoulder_link.dae" scale="1 1 1"/>
        </geometry>
        <material name="Generic"/>
