        <origin xyz="-0.000005 -0.028077 -0.045092" rpy="0 0 0"/>
        <mass value="0.355001"/>
        <inertia ixx="2.083464e-03" ixy="4.211373e-08" ixz="1.436305e-07"
                 iyy="1.868716e-03" iyz="-2.559583e-04" izz="4.177623e-04"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://marav3best_description/meshes/marav3best/RG_elbow_link.dae" scale="1 1 1"/>
